# Development-only overrides for CRA dev server to support preview/tunnel/proxy hosts.
# Note: CRA v5 uses Webpack Dev Server v4; allowedHosts: 'all' is set internally when
# DANGEROUSLY_DISABLE_HOST_CHECK is enabled. We also bind to 0.0.0.0 so external hostnames can connect.

# Bind to all interfaces
HOST=0.0.0.0

# Disable strict host checking to allow preview/tunnel hostnames
DANGEROUSLY_DISABLE_HOST_CHECK=true

# In some preview environments WDS websocket needs explicit host
# This will be ignored if not applicable; safe to include.
WDS_SOCKET_HOST=0.0.0.0

# Optional: If websockets are blocked or cause reload loops in certain proxies
# uncomment the next line to disable fast refresh socket usage.
# FAST_REFRESH=false
