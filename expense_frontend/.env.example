# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL controls the backend API base URL used by the frontend.
# If not set in development, the app will use a relative base '/api' that is proxied to http://localhost:3001
# via the "proxy" setting in package.json. In production, set this explicitly to your backend URL.
#
# Examples:
# - Local direct: http://localhost:3001
# - Deployed: https://your-domain.tld:3001
REACT_APP_API_BASE_URL=http://localhost:3001
